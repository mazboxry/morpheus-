[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scenes/ui/info_modal.gd" id="1_info"]

[node name="TutorialModal" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_info")
heading = "あそびかた"
message = "サイコロを振って仲間を召喚し、城を守り抜こう。"

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.015, 0.025, 0.07, 1)

[node name="Panel" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -210.0
offset_top = -130.0
offset_right = 210.0
offset_bottom = 130.0
grow_horizontal = 2
grow_vertical = 2

[node name="Margin" type="MarginContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/margin_left = 32
theme_override_constants/margin_top = 28
theme_override_constants/margin_right = 32
theme_override_constants/margin_bottom = 28

[node name="Menu" type="VBoxContainer" parent="Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="Heading" type="Label" parent="Panel/Margin/Menu"]
layout_mode = 2
theme_override_font_sizes/font_size = 32
horizontal_alignment = 1

[node name="Message" type="Label" parent="Panel/Margin/Menu"]
layout_mode = 2
autowrap_mode = 2
horizontal_alignment = 1

[node name="BackButton" type="Button" parent="Panel/Margin/Menu"]
layout_mode = 2
text = "タイトルへ戻る"

[connection signal="pressed" from="Panel/Margin/Menu/BackButton" to="." method="_on_back_pressed"]
